# =============================================================================
# Docker Ignore - Optimize Build Context
# =============================================================================

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist
dist-ssr
*.local

# Environment files
.env
.env.local
.env.*.local

# Git
.git
.gitignore
.gitattributes

# IDE
.idea
.vscode
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
logs
*.log

# Testing
coverage
.nyc_output

# Temporary files
tmp
temp
*.tmp

# Documentation
*.md
!README.md

# Docker files (not needed in build context)
Dockerfile
docker-compose.yml
.dockerignore

# Agent files
.Agent

# Misc
*.pem
*.cert
*.key

# Monorepo: o contexto de build e a raiz, entao excluir o que nao serve a
# nenhuma imagem e o node_modules de cada workspace.
apps/*/node_modules
apps/*/dist
.Agent
.github
docker-compose*.yml
