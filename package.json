{
  "name": "kawa-note",
  "private": true,
  "version": "0.0.0",
  "description": "Kawa Note — monorepo (web + api)",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @kawa-note/web",
    "dev:api": "npm run dev -w @kawa-note/api",
    "build": "npm run build -w @kawa-note/web",
    "lint": "npm run lint -w @kawa-note/web",
    "typecheck": "npm run typecheck -w @kawa-note/web",
    "test": "npm run test:run --workspaces --if-present",
    "test:web": "npm run test:run -w @kawa-note/web",
    "test:api": "npm run test:run -w @kawa-note/api",
    "db:migrate": "npm run db:migrate -w @kawa-note/api",
    "db:generate": "npm run db:generate -w @kawa-note/api",
    "audit:folder-scope": "npm run audit:folder-scope -w @kawa-note/api"
  }
}
